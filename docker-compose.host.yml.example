# 推荐方式：宿主网络。
# RouterOS 默认地址 http://10.0.0.1 只有在宿主网络下语义正确；
# 面板监听 :8080，无需端口映射。
#
# 使用前：
#   mkdir -p /opt/rosboard-docker && chown 1000:1000 /opt/rosboard-docker
#   cp docker-compose.host.yml.example docker-compose.yml
#   docker compose up -d
# 首次访问 http://<宿主机>:8080 进入初始化引导。

services:
  rosboard:
    image: jasonxtt/rosboard:latest
    container_name: rosboard
    network_mode: host
    # 改面板端口（默认 8080）：
    # environment:
    #   - ROSBOARD_PORT=9090
    volumes:
      - /opt/rosboard-docker:/var/lib/rosboard
    restart: unless-stopped
